# =============================================================================
# Frontend (Next.js) environment — used by Vercel / standalone Docker builds
# Copy to .env.local (dev) or set in Vercel → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED on Vercel: public URL of your FastAPI backend (no trailing slash).
# Deploy the backend on Railway/Fly.io/Render/your VPS (see DEPLOY_VERCEL.md).
# Used by:
#   - Next.js rewrites: browser calls https://your-app.vercel.app/api/*,
#     which proxies server-side to this URL (no CORS setup needed)
#   - The SSE streaming route handlers (chat / ask endpoints)
# -----------------------------------------------------------------------------
# INTERNAL_API_URL=https://your-backend.up.railway.app

# -----------------------------------------------------------------------------
# OPTIONAL: tell the browser to call the backend directly instead of going
# through this Next.js deployment. Bypasses Vercel entirely — useful for
# large file uploads or when you want zero proxy latency.
# If set, the backend must allow this frontend's origin in CORS_ORIGINS.
# Leave unset to use the rewrites proxy (recommended default on Vercel).
# -----------------------------------------------------------------------------
# API_URL=https://your-backend.up.railway.app
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# -----------------------------------------------------------------------------
# OPTIONAL: Docker-only. Forces `output: "standalone"` even if VERCEL is set
# (the Dockerfile and docker-compose builds set this themselves when needed).
# -----------------------------------------------------------------------------
# BUILD_STANDALONE=1
